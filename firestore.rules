
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /photos/{photoId} {
      // SECURE ISOLATED RETRIEVAL:
      // allow get: Public access allowed for specific ID via QR scan.
      // allow list: False. Prevents collection browsing/guessing.
      // allow write: Allows kiosk to create session metadata.
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }
  }
}
