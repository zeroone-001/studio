
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /photos/{photoId} {
      // SECURE RETRIEVAL:
      // allow get: Public access to SPECIFIC photo via unique sessionId.
      // allow list: False. Prevents collection browsing.
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }
  }
}
