
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /photos/{photoId} {
      // SECURE MALL WORKFLOW:
      // allow get: Public retrieval of specific session photo via secure ID.
      // allow list: False. Prevents collection browsing/enumeration.
      allow get: if true;
      allow list: if false;
      allow write: if true; // Kiosk write access
    }
  }
}
