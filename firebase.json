{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/retrieve/**",
        "destination": "/retrieve/[id]/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}